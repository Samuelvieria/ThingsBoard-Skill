# Copie para .tb.env e preencha. .tb.env está no .gitignore — não commite.
# Usado por scripts/tb.mjs. Prefira um usuário técnico com role restrita,
# não credencial de admin humano.
TB_URL=https://thingsboard.exemplo.com
TB_USER=integracao@exemplo.com
TB_PASSWORD=

# Descomente só para instância interna com certificado self-signed.
# Desliga a validação de TLS do Node no processo inteiro.
#TB_INSECURE=1
